    private List<string> states => cityList.Select(c => c.State).Distinct().ToList();

    private string SelectedState
    {
        get => selectedState;
        set { selectedState = value; _ = UpdateMap(); }
    }

    private string SelectedWeather
    {
        get => selectedWeather;
        set { selectedWeather = value; _ = UpdateMap(); }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initWeatherMap");
            await LoadWeatherData();
            await UpdateMap(); // only after map and data are ready
        }
    }



   private async Task LoadWeatherData()
{
    // Clear existing locations
    locations.Clear();

    // Convert cityList to WeatherLocation with static realistic weather
    locations = cityList.Select(c => new WeatherLocation
    {
        City = c.City,
        State = c.State,
        Latitude = c.Latitude,
        Longitude = c.Longitude,
        Weather = GetCityClimate(c.City) // Assign weather based on city climate
    }).ToList();

    Console.WriteLine($"Loaded {locations.Count} static locations");

    // Apply filters
    var filteredLocations = locations
        .Where(l => string.IsNullOrEmpty(selectedState) || l.State == selectedState)
        .Where(l => string.IsNullOrEmpty(selectedWeather) || l.Weather == selectedWeather)
        .ToList();

    Console.WriteLine($"Filtered locations: {filteredLocations.Count}");

    // Update the map via JS
    await JS.InvokeVoidAsync("updateWeatherMap", filteredLocations);
}

