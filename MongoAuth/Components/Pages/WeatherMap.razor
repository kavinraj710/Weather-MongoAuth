    private string TranslateWeatherCode(int code) => code switch
    {
        0 => "Clear",
        1 or 2 or 3 => "Cloudy",
        45 or 48 => "Fog",
        51 or 53 or 55 or 61 or 63 or 65 => "Rain",
        71 or 73 or 75 or 77 or 85 or 86 => "Snow",
        _ => "Cloudy"
    };

    private async Task UpdateMap()
    {
        var filtered = locations
            .Where(l => (string.IsNullOrEmpty(SelectedState) || l.State == SelectedState)
                     && (string.IsNullOrEmpty(SelectedWeather) || l.Weather == SelectedWeather))
            .ToList();

        Console.WriteLine($"Filtered locations: {filtered.Count}");
        await JS.InvokeVoidAsync("updateWeatherMap", filtered);
    }

    public class CityInfo { public string City { get; set; } public string State { get; set; } public double Latitude { get; set; } public double Longitude { get; set; } }
    public class WeatherLocation : CityInfo { public string Weather { get; set; } }
    public class OpenMeteoCurrentResponse { public CurrentWeather current_weather { get; set; } }
    public class CurrentWeather { public double temperature { get; set; } public double windspeed { get; set; } public int weathercode { get; set; } }
