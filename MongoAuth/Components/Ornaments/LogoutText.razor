@inherits UserContext
@rendermode InteractiveServer
<AuthorizeView>
    <Authorized>
        <!-- Simple Logout Button -->
        <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="@logout">
            Logout
        </MudButton>
    </Authorized>
</AuthorizeView>

<style>
    /* Optional: Remove custom styles for logout button */
    .logout-button {
        all: unset; /* Reset custom overrides */
    }
</style>

@code {
    async Task logout()
    {
        Console.WriteLine("Logging out: " + User.name);
        await Logout(User.id);
    }
}
